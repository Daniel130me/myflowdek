// Flowdeck Prisma schema — multi-tenant SaaS foundation.
//
// Tenancy:  Workspace → Project → Task.  Every project belongs to exactly one
// workspace; permissions are derived from WorkspaceMember / ProjectMember
// roles (enums), never from a user's job title.
//
// Historical data:  Comment / File / TimeLog / RaidItem keep their author FK
// as SetNull so offboarding a user (status=DELETED) never erases project
// history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ------------------------------- enums -------------------------------- */

/** Authorization role within a workspace. Drives workspace-level permissions. */
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

/** Authorization role within a single project. */
enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/** Account lifecycle. Offboarding sets DELETED + deletedAt without removing
 *  the row, so historical records stay attributable. */
enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

/** Platform-level role. SUPER_ADMIN can access the internal admin dashboard
 *  (users, workspaces, audit, system health). This is completely distinct
 *  from WorkspaceRole/ProjectRole — a SUPER_ADMIN may or may not be a
 *  workspace OWNER. */
enum PlatformRole {
  USER
  SUPER_ADMIN
}

/* ------------------------------- user --------------------------------- */

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  avatarColor   String?
  /** Display-only job title (e.g. "Project Manager"). NOT used for authz. */
  jobTitle      String?
  status        UserStatus      @default(ACTIVE)
  /** Platform-level role. SUPER_ADMIN = internal Flowdeck team with access
   *  to the admin dashboard. Completely distinct from workspace/project roles. */
  platformRole  PlatformRole    @default(USER)
  deletedAt     DateTime?
  /** Timestamp set when the user finishes onboarding. Null = not onboarded.
   *  Source of truth for onboarding state (not localStorage). */
  onboardedAt   DateTime?
  /** Set when the user clicks the email verification link. */
  emailVerifiedAt DateTime?
  ownedProjects    Project[]          @relation("ProjectOwner")
  memberships      ProjectMember[]
  workspaces       WorkspaceMember[]
  assignedTasks    Task[]             @relation("TaskAssignee")
  createdTasks     Task[]             @relation("TaskCreator")
  followingTasks   TaskFollower[]
  comments         Comment[]
  commentReactions CommentReaction[]
  files            File[]
  raidItems        RaidItem[]
  timeLogs         TimeLog[]
  activity         ActivityEntry[]
  notifications    Notification[]
  verificationTokens VerificationToken[]
  auditLogs        AuditLog[]
  sentInvitations  Invitation[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

/* ----------------------------- workspace ------------------------------ */

/** Status of a workspace invitation. */
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  members      WorkspaceMember[]
  projects     Project[]
  invitations  Invitation[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

/**
 * A workspace invitation issued by an owner/admin to an email address.
 *
 * The recipient follows the token URL to accept or decline. If they are a
 * new user, they register first (the token is preserved in the URL). Once
 * accepted, a WorkspaceMember row is created and the invitation is marked
 * ACCEPTED. Tokens expire after INVITATION_TTL_HOURS (see constants).
 */
model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole    @default(MEMBER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  declinedAt  DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([email])
  @@index([status])
}

/* ------------------------------ project ------------------------------- */

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  color       String          @default("#FE8029")
  startDate   DateTime?
  endDate     DateTime?
  isArchived  Boolean         @default(false)
  ownerId     String
  workspaceId String
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  tasks       Task[]
  tags        Tag[]
  sections    Section[]
  files       File[]
  raidItems   RaidItem[]
  comments    Comment[]
  timeLogs    TimeLog[]
  activity    ActivityEntry[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId])
  @@index([workspaceId])
  @@index([isArchived, updatedAt])
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  /** User-specific favourite flag. Moved off the shared Project model so one
   *  user starring a project does not star it for everyone. */
  isFavorite Boolean     @default(false)
  joinedAt  DateTime     @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/* ------------------------------- task --------------------------------- */

model Task {
  id           String           @id @default(cuid())
  projectId    String
  name         String
  description  String?
  status       String           @default("backlog")
  priority     String           @default("medium")
  startDate    DateTime?
  dueDate      DateTime?
  duration     Int              @default(1)
  progress     Int              @default(0)
  sortOrder    Int              @default(0)
  isMilestone  Boolean          @default(false)
  completedAt  DateTime?
  assigneeId   String?
  createdById  String?
  parentId     String?
  sectionId    String?
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parent       Task?            @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks     Task[]           @relation("TaskHierarchy")
  section      Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  dependencies TaskDependency[] @relation("DependentTask")
  blockedTasks TaskDependency[] @relation("DependencyTask")
  tags         TaskTag[]
  comments     Comment[]
  files        File[]
  timeLogs     TimeLog[]
  followers    TaskFollower[]
  activity     ActivityEntry[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([projectId, status])
  @@index([projectId, assigneeId])
  @@index([projectId, dueDate])
  @@index([parentId])
  @@index([sectionId])
}

/** Task grouping within a project (collapsible sections in the task list). */
model Section {
  id        String  @id @default(cuid())
  projectId String
  name      String
  position  Int     @default(0)
  collapsed Boolean @default(false)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
}

/** Users following a task for notifications. */
model TaskFollower {
  taskId String
  userId String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("DependencyTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
}

model Tag {
  id        String    @id @default(cuid())
  projectId String
  name      String
  color     String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]
  createdAt DateTime  @default(now())

  @@unique([projectId, name])
  @@index([projectId])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

/* --------------------- historical business data ---------------------- */
//
// These models deliberately use onDelete: SetNull on the author/uploader/user
// FK so that removing a user account (offboarding) never cascades into the
// project's comment/file/timelog history. The record stays attributable by id
// even after the user row is gone (or marked DELETED).

model Comment {
  id         String   @id @default(cuid())
  taskId     String
  projectId  String
  authorId   String?
  text       String
  /** Set when the comment is edited (null = never edited). */
  editedAt   DateTime?
  /** Self-relation for threaded replies. Null = top-level comment. */
  parentId   String?
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent     Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentReplies")
  reactions  CommentReaction[]
  createdAt  DateTime @default(now())

  @@index([taskId])
  @@index([projectId])
  @@index([authorId])
  @@index([parentId])
}

/** Emoji reaction on a comment. Unique per (commentId, userId, emoji). */
model CommentReaction {
  id        String  @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
}

model File {
  id            String   @id @default(cuid())
  projectId     String
  taskId        String?
  name          String
  size          Int      @default(0)
  mimeType      String?
  /** R2 object key (the storage path, not a public URL). */
  r2Key         String?
  uploadedById  String?
  uploadedAt    DateTime @default(now())
  url           String?
  thumbnailUrl  String?
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
  @@index([uploadedById])
}

model RaidItem {
  id          String   @id @default(cuid())
  projectId   String
  type        String
  description String
  ownerId     String?
  impact      String   @default("medium")
  status      String   @default("open")
  dateRaised  DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model TimeLog {
  id        String   @id @default(cuid())
  taskId    String
  projectId String
  userId    String?
  minutes   Int
  note      String?
  loggedAt  DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([projectId])
  @@index([userId])
}

/**
 * Business/project activity feed — distinct from the security AuditLog.
 *
 * Records significant task events (created, assigned, status changed, etc.)
 * so the task detail panel can show a timeline like:
 *   09:41  Oluwagbenga created this task
 *   10:03  Ada was assigned
 *   12:17  Status changed from Backlog → In Progress
 *
 * The `type` field is a short machine code; `description` is the
 * human-readable summary; `meta` holds structured before/after values.
 */
model ActivityEntry {
  id          String   @id @default(cuid())
  taskId      String
  projectId   String
  authorId    String?
  type        String   // 'created' | 'assigned' | 'status_change' | 'priority_change' | …
  description String
  meta        Json?
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([projectId])
  @@index([authorId])
}

/* --------------------- auth hardening models -------------------------- */

/** Token used for email verification and password reset. The `type` field
 *  distinguishes the purpose; `expiresAt` enforces a TTL. */
model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String   // 'email_verification' | 'password_reset'
  expiresAt DateTime
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, type])
}

/** Immutable audit/security log entry. Appended-only — never updated or
 *  deleted. Records auth events for compliance and incident response. */
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // 'register' | 'login' | 'login_failed' | 'logout' | …
  ip        String?
  userAgent String?
  meta      Json?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

/* --------------------------- notifications ----------------------------- */

/**
 * User-facing notification. Created when a significant event happens that the
 * user should know about: task assignment, @mention, reply, due date
 * approaching, invitation received, etc.
 *
 * `readAt` is null until the user marks it read. `actorId` is the user who
 * triggered the notification (null for system-generated events like overdue
 * checks).
 */
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'task_assigned' | 'mentioned' | 'replied' | 'due_soon' | 'overdue' | 'invitation' | 'approval' | 'status_changed'
  actorId   String?
  projectId String?
  taskId    String?
  message   String
  readAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
}
