# Database (Neon PostgreSQL)
# Use the pooled endpoint for application traffic and the direct endpoint for
# Prisma migrations and administrative commands.
DATABASE_URL="postgresql://user:password@pooled-host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@direct-host/dbname?sslmode=require"

# Legacy R2 compatibility for files created before connected storage
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

ENABLE_LEGACY_R2_UPLOADS=false

# Per-user connected storage
# STORAGE_TOKEN_ENCRYPTION_KEY must decode to exactly 32 bytes.
STORAGE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_APP_ID is the project number from Google Cloud Console.
# If not set, it's derived from the client ID (the numeric prefix).
GOOGLE_DRIVE_APP_ID=
# GOOGLE_DRIVE_DEVELOPER_KEY is an API key for Google Picker (optional when
# using OAuth tokens, but recommended for some Picker operations).
GOOGLE_DRIVE_DEVELOPER_KEY=

# AI Features
GEMINI_API_KEY=""

# NextAuth.js
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3004"

# Gmail SMTP (use a Google app password, never the account password)
GMAIL_SMTP_USER="kosokodaniel@gmail.com"
GMAIL_SMTP_APP_PASSWORD=""
GMAIL_SMTP_PORT="587"
EMAIL_FROM="kosokodaniel@gmail.com"
APP_BASE_URL="http://localhost:3004"
