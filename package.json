{
  "name": "flowdeck",
  "version": "0.2.1",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/shared/navigation/routes.test.ts src/providers/FlowdekDataProvider.test.ts src/data/local-storage/storageAdapter.test.ts src/features/tasks/selectors/getTaskForProject.test.ts src/features/files/selectors/getFileForProject.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "verify": "npm run db:generate && npm run check && npm run build",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.7",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
