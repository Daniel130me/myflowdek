generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  avatarColor   String?
  role          String?
  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  assignedTasks Task[]          @relation("TaskAssignee")
  createdTasks  Task[]          @relation("TaskCreator")
  comments      Comment[]
  files         File[]
  raidItems     RaidItem[]
  timeLogs      TimeLog[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  color       String          @default("#FE8029")
  startDate   DateTime?
  endDate     DateTime?
  isFavorite  Boolean         @default(false)
  isArchived  Boolean         @default(false)
  ownerId     String
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  tasks       Task[]
  tags        Tag[]
  files       File[]
  raidItems   RaidItem[]
  comments    Comment[]
  timeLogs    TimeLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId])
  @@index([isArchived, updatedAt])
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("member")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id           String           @id @default(cuid())
  projectId    String
  name         String
  description  String?
  status       String           @default("backlog")
  priority     String           @default("medium")
  startDate    DateTime?
  dueDate      DateTime?
  duration     Int              @default(1)
  progress     Int              @default(0)
  sortOrder    Int              @default(0)
  isMilestone  Boolean          @default(false)
  completedAt  DateTime?
  assigneeId   String?
  createdById  String?
  parentId     String?
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parent       Task?            @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks     Task[]           @relation("TaskHierarchy")
  dependencies TaskDependency[] @relation("DependentTask")
  blockedTasks TaskDependency[] @relation("DependencyTask")
  tags         TaskTag[]
  comments     Comment[]
  files        File[]
  timeLogs     TimeLog[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([projectId, status])
  @@index([projectId, assigneeId])
  @@index([projectId, dueDate])
  @@index([parentId])
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("DependencyTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
}

model Tag {
  id        String    @id @default(cuid())
  projectId String
  name      String
  color     String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]
  createdAt DateTime  @default(now())

  @@unique([projectId, name])
  @@index([projectId])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  projectId String
  authorId  String
  text      String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([projectId])
}

model File {
  id            String   @id @default(cuid())
  projectId     String
  taskId        String?
  name          String
  size          Int      @default(0)
  uploadedById  String
  uploadedAt    DateTime @default(now())
  url           String?
  thumbnailUrl  String?
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
}

model RaidItem {
  id          String   @id @default(cuid())
  projectId   String
  type        String
  description String
  ownerId     String?
  impact      String   @default("medium")
  status      String   @default("open")
  dateRaised  DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model TimeLog {
  id        String   @id @default(cuid())
  taskId    String
  projectId String
  userId    String
  minutes   Int
  note      String?
  loggedAt  DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId])
  @@index([userId])
}
