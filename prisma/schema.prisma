// Flowdeck Prisma schema — multi-tenant SaaS foundation.
//
// Tenancy:  Workspace → Project → Task.  Every project belongs to exactly one
// workspace; permissions are derived from WorkspaceMember / ProjectMember
// roles (enums), never from a user's job title.
//
// Historical data:  Comment / File / TimeLog / RaidItem keep their author FK
// as SetNull so offboarding a user (status=DELETED) never erases project
// history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/**
 * ------------------------------- enums --------------------------------
 */

/**
 * Authorization role within a workspace. Drives workspace-level permissions.
 */
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

/**
 * Authorization role within a single project.
 */
enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/**
 * Account lifecycle. Offboarding sets DELETED + deletedAt without removing
 * the row, so historical records stay attributable.
 */
enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

/**
 * Platform-level role. SUPER_ADMIN can access the internal admin dashboard
 * (users, workspaces, audit, system health). This is completely distinct
 * from WorkspaceRole/ProjectRole — a SUPER_ADMIN may or may not be a
 * workspace OWNER.
 */
enum PlatformRole {
  USER
  SUPER_ADMIN
}

/**
 * User-owned cloud storage providers supported by Flowdek.
 */
enum StorageProvider {
  GOOGLE_DRIVE
  ONEDRIVE
  DROPBOX
}

enum ProjectDocumentPhase {
  INITIATION
  PLANNING
  EXECUTION_MONITORING
  CLOSING
}

enum TemplateDocumentType {
  GOOGLE_DOC
  GOOGLE_SHEET
  FLOWDEK_GENERATED
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum ProfileVisibility {
  PRIVATE
  FLOWDEK_USERS
}

enum AvailabilityStatus {
  AVAILABLE_NOW
  AVAILABLE_SOON
  LIMITED
  UNAVAILABLE
}

enum RateType {
  HOURLY
  FIXED
  NEGOTIABLE
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum RemotePreference {
  REMOTE_ONLY
  HYBRID
  ONSITE
  FLEXIBLE
}

enum SkillCategory {
  SOFTWARE_DEVELOPMENT
  DESIGN
  PROJECT_MANAGEMENT
  CLOUD_DEVOPS
  DATA
  MARKETING
  BUSINESS
  WRITING
  QUALITY_ASSURANCE
  SECURITY
}

enum TalentInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
  AWARDED
  CANCELLED
}

enum ProposalStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum EngagementStatus {
  DRAFT
  AWAITING_PROFESSIONAL_ACCEPTANCE
  ACTIVE
  WORK_SUBMITTED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MilestoneStatus {
  PENDING
  ACTIVE
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

/**
 * ------------------------------- user ---------------------------------
 */

model User {
  id                      String                @id @default(cuid())
  email                   String                @unique
  name                    String?
  passwordHash            String?
  avatarUrl               String?
  avatarColor             String?
  /**
   * Display-only job title (e.g. "Project Manager"). NOT used for authz.
   */
  jobTitle                String?
  status                  UserStatus            @default(ACTIVE)
  /**
   * Platform-level role. SUPER_ADMIN = internal Flowdeck team with access
   * to the admin dashboard. Completely distinct from workspace/project roles.
   */
  platformRole            PlatformRole          @default(USER)
  /**
   * Incremented on password reset / account disable / logout-all to
   * invalidate existing JWT sessions. The JWT carries sessionVersion;
   * mismatch = session revoked.
   */
  sessionVersion          Int                   @default(0)
  deletedAt               DateTime?
  /**
   * Timestamp set when the user finishes onboarding. Null = not onboarded.
   * Source of truth for onboarding state (not localStorage).
   */
  onboardedAt             DateTime?
  /**
   * Set when the user clicks the email verification link.
   */
  emailVerifiedAt         DateTime?
  ownedProjects           Project[]             @relation("ProjectOwner")
  memberships             ProjectMember[]
  workspaces              WorkspaceMember[]
  assignedTasks           Task[]                @relation("TaskAssignee")
  createdTasks            Task[]                @relation("TaskCreator")
  followingTasks          TaskFollower[]
  comments                Comment[]
  commentReactions        CommentReaction[]
  files                   File[]
  storageConnections      StorageConnection[]
  raidItems               RaidItem[]
  timeLogs                TimeLog[]
  activity                ActivityEntry[]
  notifications           Notification[]
  savedFilters            SavedFilter[]
  commentMentions         CommentMention[]
  projectStatusUpdates    ProjectStatusUpdate[]
  workspacePreferences    WorkspacePreference[]
  approvalRequests        ApprovalRequest[]     @relation("ApprovalRequester")
  approvalsToResolve      ApprovalRequest[]     @relation("ApprovalApprover")
  timesheets              TimesheetEntry[]
  expenses                Expense[]             @relation("ExpenseCreator")
  formSubmissions         FormSubmission[]      @relation("FormSubmitter")
  verificationTokens      VerificationToken[]
  auditLogs               AuditLog[]
  sentInvitations         Invitation[]
  createdProjectDocuments ProjectDocument[]     @relation("ProjectDocumentCreator")
  professionalProfile     ProfessionalProfile?
  sentTalentInvitations   TalentInvitation[]      @relation("TalentInvitationSender")
  createdOpportunities    TalentOpportunity[]     @relation("OpportunityCreator")
  clientEngagements       Engagement[]            @relation("ClientEngagements")
  submittedDeliverables   EngagementDeliverable[] @relation("DeliverableSubmitter")
  engagementActivities    EngagementActivity[]    @relation("EngagementActivityAuthor")
  refundRequests          Refund[]                @relation("RefundRequester")
  clientReviewsGiven      ProfessionalReview[]    @relation("ReviewerClient")
  clientReviewsReceived   ClientReview[]          @relation("ReviewedClient")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

/**
 * ----------------------- talent network profile -----------------------
 */

model ProfessionalProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  slug                  String                 @unique
  professionalTitle     String?
  bio                   String?
  yearsOfExperience     Int?
  visibility            ProfileVisibility      @default(PRIVATE)
  status                ProfileStatus          @default(DRAFT)
  location              String?
  timezone              String?
  remotePreference      RemotePreference?
  rateType              RateType?
  minimumRate           Decimal?               @db.Decimal(12, 2)
  maximumRate           Decimal?               @db.Decimal(12, 2)
  currency              String?                @db.Char(3)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles                 ProfessionalProfileRole[]
  skills                ProfessionalSkill[]
  portfolioItems        PortfolioItem[]
  availability          ProfessionalAvailability?
  invitations           TalentInvitation[]
  proposals             TalentProposal[]
  engagements           Engagement[]
  paymentAccounts       ProfessionalPaymentAccount[]
  payouts               ProfessionalPayout[]
  reviews               ProfessionalReview[]
  clientReviews         ClientReview[]
  metrics               ProfessionalMetrics?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status, visibility, updatedAt])
  @@index([status, visibility, professionalTitle])
  @@index([status, visibility, location])
  @@index([status, visibility, timezone])
  @@index([status, visibility, remotePreference])
  @@index([status, visibility, rateType, minimumRate])
}

model ProfessionalRole {
  id          String                    @id @default(cuid())
  slug        String                    @unique
  name        String                    @unique
  description String?
  sortOrder   Int                       @default(0)
  isActive    Boolean                   @default(true)
  profiles    ProfessionalProfileRole[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([isActive, sortOrder])
}

model Skill {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String              @unique
  category    SkillCategory
  description String?
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  profiles         ProfessionalSkill[]
  taskRequirements TaskCompetencyRequirement[]
  opportunityRequirements OpportunitySkillRequirement[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([category, isActive, sortOrder])
}

model ProfessionalProfileRole {
  profileId String
  roleId    String
  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role      ProfessionalRole    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([profileId, roleId])
  @@index([roleId])
}

model ProfessionalSkill {
  profileId   String
  skillId     String
  proficiency ProficiencyLevel
  isVerified  Boolean             @default(false)
  profile     ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill       Skill               @relation(fields: [skillId], references: [id], onDelete: Restrict)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@id([profileId, skillId])
  @@index([skillId, proficiency])
}

model PortfolioItem {
  id          String              @id @default(cuid())
  profileId   String
  title       String
  description String?
  url         String
  sortOrder   Int                 @default(0)
  profile     ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([profileId, sortOrder])
}

model ProfessionalAvailability {
  id                   String             @id @default(cuid())
  profileId            String             @unique
  status               AvailabilityStatus @default(UNAVAILABLE)
  weeklyAvailableHours Int?
  availableFrom        DateTime?
  profile              ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

/**
 * ----------------------------- workspace ------------------------------
 */

/**
 * Status of a workspace invitation.
 */
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  projects    Project[]
  invitations Invitation[]
  preferences WorkspacePreference[]
  goals       Goal[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

/**
 * A workspace invitation issued by an owner/admin to an email address.
 * The recipient follows the token URL to accept or decline. If they are a
 * new user, they register first (the token is preserved in the URL). Once
 * accepted, a WorkspaceMember row is created and the invitation is marked
 * ACCEPTED. Tokens expire after INVITATION_TTL_HOURS (see constants).
 */
model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole    @default(MEMBER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  declinedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([email])
  @@index([status])
}

/**
 * ------------------------------ project -------------------------------
 */

model Project {
  id              String                @id @default(cuid())
  name            String
  description     String?
  color           String                @default("#FE8029")
  startDate       DateTime?
  endDate         DateTime?
  isArchived      Boolean               @default(false)
  ownerId         String
  workspaceId     String
  owner           User                  @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members         ProjectMember[]
  tasks           Task[]
  tags            Tag[]
  sections        Section[]
  files           File[]
  raidItems       RaidItem[]
  comments        Comment[]
  timeLogs        TimeLog[]
  activity        ActivityEntry[]
  approvals       ApprovalRequest[]
  forms           Form[]
  formSubmissions FormSubmission[]
  automations     AutomationRule[]
  timesheets      TimesheetEntry[]
  budgets         Budget[]
  expenses        Expense[]
  statusUpdates   ProjectStatusUpdate[]
  customFields    CustomField[]
  documents       ProjectDocument[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([ownerId])
  @@index([workspaceId])
  @@index([isArchived, updatedAt])
}

model ProjectMember {
  projectId  String
  userId     String
  role       ProjectRole @default(MEMBER)
  /**
   * User-specific favourite flag. Moved off the shared Project model so one
   * user starring a project does not star it for everyone.
   */
  isFavorite Boolean     @default(false)
  joinedAt   DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/**
 * ------------------------------- task ---------------------------------
 */

model Task {
  id                 String                 @id @default(cuid())
  projectId          String
  name               String
  description        String?
  status             String                 @default("backlog")
  priority           String                 @default("medium")
  startDate          DateTime?
  dueDate            DateTime?
  duration           Int                    @default(1)
  progress           Int                    @default(0)
  sortOrder          Int                    @default(0)
  isMilestone        Boolean                @default(false)
  /**
   * Recurrence pattern: 'daily' | 'weekly' | 'monthly' | null. When set,
   * a background job creates the next occurrence after completion.
   */
  recurrence         String?
  completedAt        DateTime?
  assigneeId         String?
  createdById        String?
  parentId           String?
  sectionId          String?
  /**
   * Points to the original recurring task that produced this task instance.
   * Distinct from `parentId` (subtask hierarchy) — a recurring instance is
   * NOT a subtask of its source. Set by the recurrence service; null for
   * one-off tasks and the original recurring template itself.
   */
  recurrenceSourceId String?
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee           User?                  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy          User?                  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parent             Task?                  @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks           Task[]                 @relation("TaskHierarchy")
  recurrenceSource   Task?                  @relation("TaskRecurrenceSource", fields: [recurrenceSourceId], references: [id], onDelete: SetNull)
  recurrenceChildren Task[]                 @relation("TaskRecurrenceSource")
  section            Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  dependencies       TaskDependency[]       @relation("DependentTask")
  blockedTasks       TaskDependency[]       @relation("DependencyTask")
  tags               TaskTag[]
  comments           Comment[]
  files              File[]
  timeLogs           TimeLog[]
  followers          TaskFollower[]
  activity           ActivityEntry[]
  approvals          ApprovalRequest[]
  customFieldValues  TaskCustomFieldValue[]
  formSubmissions    FormSubmission[]       @relation("FormConvertedTask")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  timesheetEntries       TimesheetEntry[]
  competencyRequirements TaskCompetencyRequirement[]
  talentInvitations      TalentInvitation[]
  talentOpportunities    TalentOpportunity[]
  engagements            Engagement[]

  @@index([projectId, status])
  @@index([projectId, assigneeId])
  @@index([projectId, dueDate])
  @@index([parentId])
  @@index([sectionId])
  @@index([recurrenceSourceId])
}

/**
 * Task grouping within a project (collapsible sections in the task list).
 */
model TaskCompetencyRequirement {
  id                 String           @id @default(cuid())
  taskId             String
  skillId            String
  minimumProficiency ProficiencyLevel
  isRequired         Boolean          @default(true)
  notes              String?
  task               Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skill              Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([taskId, skillId])
  @@index([skillId, minimumProficiency])
}

model TalentInvitation {
  id                    String                 @id @default(cuid())
  taskId                String
  professionalProfileId String
  invitedById           String
  message               String?
  proposedBudget        Decimal?               @db.Decimal(12, 2)
  currency              String?                @db.Char(3)
  proposedDeadline      DateTime?
  status                TalentInvitationStatus @default(PENDING)
  expiresAt             DateTime
  respondedAt           DateTime?
  task                  Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  professionalProfile   ProfessionalProfile    @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  invitedBy             User                   @relation("TalentInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([taskId, status, createdAt])
  @@index([professionalProfileId, status, createdAt])
  @@index([invitedById])
}

model TalentOpportunity {
  id                   String                       @id @default(cuid())
  taskId               String
  createdById          String
  status               OpportunityStatus            @default(DRAFT)
  title                String
  description          String
  deliverablesSummary  String?
  budgetType           RateType?
  minimumBudget        Decimal?                     @db.Decimal(12, 2)
  maximumBudget        Decimal?                     @db.Decimal(12, 2)
  currency             String?                      @db.Char(3)
  expectedDuration     String?
  applicationDeadline  DateTime?
  publishedAt          DateTime?
  closedAt             DateTime?
  task                 Task                         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy            User                         @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  proposals            TalentProposal[]
  requiredSkills       OpportunitySkillRequirement[]
  engagements          Engagement[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([status, publishedAt])
  @@index([taskId, status])
  @@index([createdById])
}

model OpportunitySkillRequirement {
  id                 String            @id @default(cuid())
  opportunityId      String
  skillId            String
  minimumProficiency ProficiencyLevel
  isRequired         Boolean           @default(true)
  notes              String?
  opportunity        TalentOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill              Skill             @relation(fields: [skillId], references: [id], onDelete: Restrict)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([opportunityId, skillId])
  @@index([skillId, minimumProficiency])
}

model TalentProposal {
  id                    String              @id @default(cuid())
  opportunityId         String
  professionalProfileId String
  proposedPrice         Decimal             @db.Decimal(12, 2)
  currency              String              @db.Char(3)
  estimatedDuration     String
  coverMessage          String
  proposedApproach      String?
  milestoneSuggestions  Json?
  status                ProposalStatus      @default(SUBMITTED)
  submittedAt           DateTime            @default(now())
  reviewedAt            DateTime?
  respondedAt           DateTime?
  opportunity           TalentOpportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  engagement            Engagement?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([opportunityId, professionalProfileId])
  @@index([opportunityId, status, createdAt])
  @@index([professionalProfileId, status, createdAt])
}

model Engagement {
  id                    String                @id @default(cuid())
  taskId                String
  opportunityId         String?
  proposalId            String?               @unique
  professionalProfileId String
  clientUserId          String
  status                EngagementStatus      @default(DRAFT)
  title                 String
  scopeDescription      String
  agreedPrice           Decimal               @db.Decimal(12, 2)
  currency              String                @default("USD") @db.Char(3)
  startDate             DateTime?
  deadline              DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  disputedAt            DateTime?
  cancellationReason    String?
  disputeReason         String?
  termsAcceptedAt       DateTime?
  task                  Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  opportunity           TalentOpportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  proposal              TalentProposal?       @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  professionalProfile   ProfessionalProfile   @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  clientUser            User                  @relation("ClientEngagements", fields: [clientUserId], references: [id], onDelete: Restrict)
  milestones            EngagementMilestone[]
  deliverables          EngagementDeliverable[]
  activities            EngagementActivity[]
  payments              EngagementPayment[]
  professionalReview    ProfessionalReview?
  clientReview          ClientReview?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([taskId, status])
  @@index([professionalProfileId, status])
  @@index([clientUserId, status])
  @@index([status, updatedAt])
}

model EngagementMilestone {
  id              String                  @id @default(cuid())
  engagementId    String
  title           String
  description     String?
  amount          Decimal                 @db.Decimal(12, 2)
  dueDate         DateTime?
  sortOrder       Int                     @default(0)
  status          MilestoneStatus         @default(PENDING)
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  engagement      Engagement              @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  deliverables    EngagementDeliverable[]
  payments        EngagementPayment[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([engagementId, sortOrder])
  @@index([engagementId, status])
}

model EngagementDeliverable {
  id           String               @id @default(cuid())
  engagementId String
  milestoneId  String?
  submittedById String
  title        String
  description  String?
  fileUrl      String?
  externalUrl  String?
  notes        String?
  submittedAt  DateTime             @default(now())
  engagement   Engagement           @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  milestone    EngagementMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  submittedBy  User                 @relation("DeliverableSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([engagementId, submittedAt])
  @@index([milestoneId])
  @@index([submittedById])
}

model EngagementActivity {
  id           String     @id @default(cuid())
  engagementId String
  authorId     String?
  type         String
  description  String
  metadata     Json?
  createdAt    DateTime   @default(now())
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  author       User?      @relation("EngagementActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([engagementId, createdAt])
  @@index([authorId])
}

model Section {
  id        String  @id @default(cuid())
  projectId String
  name      String
  position  Int     @default(0)
  collapsed Boolean @default(false)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
}

/**
 * Users following a task for notifications.
 */
model TaskFollower {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("DependencyTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
}

model Tag {
  id        String    @id @default(cuid())
  projectId String
  name      String
  color     String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]
  createdAt DateTime  @default(now())

  @@unique([projectId, name])
  @@index([projectId])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

/**
 * --------------------- historical business data ----------------------
 */
//
// These models deliberately use onDelete: SetNull on the author/uploader/user
// FK so that removing a user account (offboarding) never cascades into the
// project's comment/file/timelog history. The record stays attributable by id
// even after the user row is gone (or marked DELETED).

model Comment {
  id        String            @id @default(cuid())
  taskId    String
  projectId String
  authorId  String?
  text      String
  /**
   * Set when the comment is edited (null = never edited).
   */
  editedAt  DateTime?
  /**
   * Self-relation for threaded replies. Null = top-level comment.
   */
  parentId  String?
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]
  mentions  CommentMention[]
  createdAt DateTime          @default(now())

  @@index([taskId])
  @@index([projectId])
  @@index([authorId])
  @@index([parentId])
}

/**
 * Emoji reaction on a comment. Unique per (commentId, userId, emoji).
 */
model CommentReaction {
  id        String  @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
}

model File {
  id                  String             @id @default(cuid())
  projectId           String
  taskId              String?
  name                String
  size                Int                @default(0)
  mimeType            String?
  /**
   * Deprecated legacy metadata. New uploads use the connected fields below.
   */
  r2Key               String?
  storageProvider     StorageProvider?
  storageConnectionId String?
  providerFileId      String?
  providerPath        String?
  providerWebUrl      String?
  uploadedById        String?
  uploadedAt          DateTime           @default(now())
  url                 String?
  thumbnailUrl        String?
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedBy          User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  storageConnection   StorageConnection? @relation(fields: [storageConnectionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
  @@index([uploadedById])
  @@index([storageConnectionId])
}

/**
 * OAuth credentials for a cloud drive connected by one Flowdek user.
 */
model StorageConnection {
  id                    String            @id @default(cuid())
  userId                String
  provider              StorageProvider
  providerAccountId     String?
  providerEmail         String?
  encryptedAccessToken  String
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  scope                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  files                 File[]
  projectDocuments      ProjectDocument[]

  @@unique([userId, provider])
  @@index([userId])
}

model DocumentTemplate {
  id           String               @id @default(cuid())
  slug         String               @unique
  name         String
  description  String
  phase        ProjectDocumentPhase
  documentType TemplateDocumentType
  content      Json
  thumbnailUrl String?
  tags         String[]
  version      Int                  @default(1)
  isPublished  Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  documents    ProjectDocument[]

  @@index([phase, isPublished])
  @@index([documentType, isPublished])
}

model ProjectDocument {
  id                  String            @id @default(cuid())
  projectId           String
  templateId          String?
  createdById         String
  name                String
  storageProvider     StorageProvider
  storageConnectionId String
  providerFileId      String
  providerWebUrl      String
  mimeType            String?
  thumbnailUrl        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template            DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy           User              @relation("ProjectDocumentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  storageConnection   StorageConnection @relation(fields: [storageConnectionId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([templateId])
  @@index([createdById])
  @@index([storageConnectionId])
}

model RaidItem {
  id          String   @id @default(cuid())
  projectId   String
  type        String
  description String
  ownerId     String?
  impact      String   @default("medium")
  status      String   @default("open")
  dateRaised  DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model TimeLog {
  id        String   @id @default(cuid())
  taskId    String
  projectId String
  userId    String?
  minutes   Int
  note      String?
  loggedAt  DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([projectId])
  @@index([userId])
}

/**
 * Business/project activity feed — distinct from the security AuditLog.
 * Records significant task events (created, assigned, status changed, etc.)
 * so the task detail panel can show a timeline like:
 * 09:41  Oluwagbenga created this task
 * 10:03  Ada was assigned
 * 12:17  Status changed from Backlog → In Progress
 * The `type` field is a short machine code; `description` is the
 * human-readable summary; `meta` holds structured before/after values.
 */
model ActivityEntry {
  id          String   @id @default(cuid())
  taskId      String
  projectId   String
  authorId    String?
  type        String // 'created' | 'assigned' | 'status_change' | 'priority_change' | …
  description String
  meta        Json?
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([projectId])
  @@index([authorId])
}

/**
 * --------------------- auth hardening models --------------------------
 */

/**
 * Token used for email verification and password reset. The `type` field
 * distinguishes the purpose; `expiresAt` enforces a TTL.
 */
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      String // 'email_verification' | 'password_reset'
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

/**
 * Immutable audit/security log entry. Appended-only — never updated or
 * deleted. Records auth events for compliance and incident response.
 */
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // 'register' | 'login' | 'login_failed' | 'logout' | …
  ip        String?
  userAgent String?
  meta      Json?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

/**
 * --------------------------- notifications -----------------------------
 */

/**
 * User-facing notification. Created when a significant event happens that the
 * user should know about: task assignment, @mention, reply, due date
 * approaching, invitation received, etc.
 * `readAt` is null until the user marks it read. `actorId` is the user who
 * triggered the notification (null for system-generated events like overdue
 * checks).
 */
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // 'task_assigned' | 'mentioned' | 'replied' | 'due_soon' | 'overdue' | 'invitation' | 'approval' | 'status_changed'
  actorId   String?
  projectId String?
  taskId    String?
  message   String
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
}

/**
 * ------------------------- advanced features ---------------------------
 */

/**
 * Status of a goal/OKR.
 */
enum GoalStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  OFF_TRACK
  COMPLETED
}

/**
 * Approval status.
 */
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Org/workspace-level objective with measurable key results.
 */
model Goal {
  id          String      @id @default(cuid())
  workspaceId String
  title       String
  description String?
  status      GoalStatus  @default(NOT_STARTED)
  startDate   DateTime?
  endDate     DateTime?
  parentId    String?
  parent      Goal?       @relation("GoalHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Goal[]      @relation("GoalHierarchy")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  keyResults  KeyResult[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([workspaceId])
  @@index([parentId])
}

model KeyResult {
  id           String   @id @default(cuid())
  goalId       String
  title        String
  targetValue  Float    @default(100)
  currentValue Float    @default(0)
  unit         String   @default("%")
  goal         Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([goalId])
}

/**
 * Approval request linked to a task.
 */
model ApprovalRequest {
  id          String         @id @default(cuid())
  taskId      String
  projectId   String
  /**
   * Nullable so offboarding a user (User.status=DELETED) can set NULL
   * instead of cascading — preserving the approval history.
   */
  requesterId String?
  approverId  String?
  status      ApprovalStatus @default(PENDING)
  comment     String?
  requestedAt DateTime       @default(now())
  resolvedAt  DateTime?
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester   User?          @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  approver    User?          @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([approverId, status])
  @@index([requesterId])
}

/**
 * Intake form that converts submissions into tasks.
 */
model Form {
  id          String           @id @default(cuid())
  projectId   String
  name        String
  description String?
  fields      Json
  isActive    Boolean          @default(true)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([projectId])
}

model FormSubmission {
  id              String   @id @default(cuid())
  formId          String
  projectId       String
  data            Json
  /**
   * Nullable + SetNull so anonymous (public-form) submissions and
   * offboarded users don't lose their submission history.
   */
  submittedBy     String?
  /**
   * Points to the Task created by converting this submission. SetNull so
   * deleting the converted task doesn't destroy the submission audit trail.
   */
  convertedTaskId String?
  submittedAt     DateTime @default(now())
  form            Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedByUser User?    @relation("FormSubmitter", fields: [submittedBy], references: [id], onDelete: SetNull)
  convertedTask   Task?    @relation("FormConvertedTask", fields: [convertedTaskId], references: [id], onDelete: SetNull)

  @@index([formId])
  @@index([projectId])
  @@index([submittedBy])
  @@index([convertedTaskId])
}

/**
 * Trigger-action automation rule.
 */
model AutomationRule {
  id        String   @id @default(cuid())
  projectId String
  name      String
  enabled   Boolean  @default(true)
  trigger   Json
  actions   Json
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/**
 * Weekly timesheet entry for approval workflow.
 */
model TimesheetEntry {
  id        String   @id @default(cuid())
  /**
   * Nullable + SetNull so historical timesheets survive user offboarding.
   */
  userId    String?
  projectId String
  /**
   * Optional FK to a Task — SetNull so deleting the task keeps the timesheet.
   */
  taskId    String?
  date      DateTime
  hours     Float
  note      String?
  submitted Boolean  @default(false)
  approved  Boolean  @default(false)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([projectId])
  @@index([submitted, approved])
  @@index([taskId])
}

/**
 * Project-level financial budget.
 */
model Budget {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  totalBudget Float     @default(0)
  spent       Float     @default(0)
  currency    String    @default("USD")
  startDate   DateTime?
  endDate     DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}

model Expense {
  id            String   @id @default(cuid())
  budgetId      String
  projectId     String
  description   String
  amount        Float
  category      String   @default("general")
  date          DateTime @default(now())
  /**
   * Nullable + SetNull so historical expenses survive user offboarding.
   */
  createdBy     String?
  budget        Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation("ExpenseCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([projectId])
  @@index([createdBy])
}

/**
 * --------------------- missing existing domains ------------------------
 */

/**
 * Per-user workspace preferences (onboarding + settings).
 */
model WorkspacePreference {
  id                  String    @id @default(cuid())
  workspaceId         String
  userId              String
  defaultView         String?
  enableNotifications Boolean   @default(true)
  theme               String? // 'light' | 'dark' | 'system'
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

/**
 * Structured @mention on a comment (replaces text-based parsing).
 */
model CommentMention {
  commentId String
  userId    String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

/**
 * Pinned status update on a project dashboard (green/yellow/red).
 */
model ProjectStatusUpdate {
  id        String   @id @default(cuid())
  projectId String
  authorId  String?
  text      String
  color     String   @default("green") // 'green' | 'yellow' | 'red'
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([projectId])
}

/**
 * User-specific saved search filter.
 */
model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  isPinned  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

/**
 * Project-specific custom field definition.
 */
model CustomField {
  id        String                 @id @default(cuid())
  projectId String
  key       String
  label     String
  type      String // 'text' | 'number' | 'date' | 'select'
  options   Json?
  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values    TaskCustomFieldValue[]

  @@unique([projectId, key])
  @@index([projectId])
}

/**
 * Per-task custom field value.
 */
model TaskCustomFieldValue {
  id      String      @id @default(cuid())
  taskId  String
  fieldId String
  value   String?
  task    Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field   CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([taskId, fieldId])
  @@index([taskId])
}

/**
 * ------------------- marketplace payments & reviews -------------------
 */

enum PaymentState {
  UNFUNDED
  FUNDING_PENDING
  FUNDED
  RELEASE_PENDING
  RELEASED
  REFUND_PENDING
  REFUNDED
  FAILED
  DISPUTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

model ProfessionalPaymentAccount {
  id                    String              @id @default(cuid())
  professionalProfileId String
  provider              String              @default("PAYSTACK") // 'PAYSTACK' | 'STRIPE'
  accountCode           String              @unique
  accountNumberMasked   String
  bankName              String
  bankCode              String
  currency              String              @default("NGN") @db.Char(3)
  isVerified            Boolean             @default(true)
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([professionalProfileId])
}

model EngagementPayment {
  id                String                @id @default(cuid())
  engagementId      String
  milestoneId       String?
  amount            Decimal               @db.Decimal(12, 2)
  platformFee       Decimal               @default(0) @db.Decimal(12, 2)
  netAmount         Decimal               @db.Decimal(12, 2)
  currency          String                @default("NGN") @db.Char(3)
  state             PaymentState          @default(UNFUNDED)
  provider          String                @default("PAYSTACK")
  providerReference String?               @unique
  fundedAt          DateTime?
  releasedAt        DateTime?
  refundedAt        DateTime?
  engagement        Engagement            @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  milestone         EngagementMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  transactions      PaymentTransaction[]
  payouts           ProfessionalPayout[]
  refunds           Refund[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([engagementId, state])
  @@index([milestoneId])
}

model PaymentTransaction {
  id                  String            @id @default(cuid())
  engagementPaymentId String
  type                String            // 'FUNDING' | 'RELEASE' | 'REFUND' | 'PLATFORM_FEE'
  amount              Decimal           @db.Decimal(12, 2)
  currency            String            @db.Char(3)
  status              String            // 'PENDING' | 'SUCCESS' | 'FAILED'
  providerReference   String?
  rawPayload          Json?
  engagementPayment   EngagementPayment @relation(fields: [engagementPaymentId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@index([engagementPaymentId])
}

model ProfessionalPayout {
  id                    String              @id @default(cuid())
  professionalProfileId String
  engagementPaymentId   String
  amount                Decimal             @db.Decimal(12, 2)
  currency              String              @db.Char(3)
  status                PayoutStatus        @default(PENDING)
  providerReference     String?             @unique
  transferredAt         DateTime?
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  engagementPayment     EngagementPayment   @relation(fields: [engagementPaymentId], references: [id], onDelete: Restrict)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([professionalProfileId])
  @@index([engagementPaymentId])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  provider        String    // 'PAYSTACK' | 'STRIPE'
  providerEventId String    @unique
  eventType       String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([provider, eventType])
}

model Refund {
  id                  String            @id @default(cuid())
  engagementPaymentId String
  requestedById       String
  amount              Decimal           @db.Decimal(12, 2)
  reason              String
  status              String            @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED'
  processedAt         DateTime?
  engagementPayment   EngagementPayment @relation(fields: [engagementPaymentId], references: [id], onDelete: Cascade)
  requestedBy         User              @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([engagementPaymentId])
  @@index([requestedById])
}

model ProfessionalReview {
  id                    String              @id @default(cuid())
  engagementId          String              @unique
  professionalProfileId String
  clientUserId          String
  qualityRating         Int
  communicationRating   Int
  competenceRating      Int
  timelinessRating      Int
  wouldHireAgain        Boolean             @default(true)
  writtenFeedback       String?
  engagement            Engagement          @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  clientUser            User                @relation("ReviewerClient", fields: [clientUserId], references: [id], onDelete: Restrict)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([professionalProfileId])
  @@index([clientUserId])
}

model ClientReview {
  id                    String              @id @default(cuid())
  engagementId          String              @unique
  clientUserId          String
  professionalProfileId String
  clarityRating         Int
  communicationRating   Int
  professionalismRating Int
  paymentRating         Int?
  wouldWorkAgain        Boolean             @default(true)
  writtenFeedback       String?
  engagement            Engagement          @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  clientUser            User                @relation("ReviewedClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([clientUserId])
  @@index([professionalProfileId])
}

model ProfessionalMetrics {
  id                    String              @id @default(cuid())
  professionalProfileId String              @unique
  completedEngagements  Int                 @default(0)
  completionRate        Float               @default(100.0)
  onTimeRate            Float               @default(100.0)
  averageRating         Float               @default(0.0)
  repeatHireCount       Int                 @default(0)
  totalReviews          Int                 @default(0)
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  updatedAt             DateTime            @updatedAt
}

